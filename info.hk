! cosmic — środowisko graficzne COSMIC (System76 / Epoch) dla HPM
! Budowane ze źródeł upstream (github.com/pop-os/cosmic-epoch) przez build.toml.
! To PEŁNE środowisko graficzne (kompozytor + panel + launcher + ustawienia +
! menedżer plików + ...), nie pojedyncza aplikacja — zobacz README.md w tym
! katalogu po szczegóły, ograniczenia i instrukcję integracji z sesją logowania.

[metadata]
-> name    => cosmic
-> version => 1.4.0
-> authors => HackerOS Team <hackeros068@gmail.com> (upstream: System76 / pop-os)
-> license => GPL-3.0-or-later
-> gui     => true
-> bins.cosmic-session       => "bin/cosmic-session"
-> bins.cosmic-comp          => "bin/cosmic-comp"
-> bins.cosmic-panel         => "bin/cosmic-panel"
-> bins.cosmic-launcher      => "bin/cosmic-launcher"
-> bins.cosmic-files         => "bin/cosmic-files"
-> bins.cosmic-settings      => "bin/cosmic-settings"
-> bins.cosmic-app-library   => "bin/cosmic-app-library"
-> bins.cosmic-bg            => "bin/cosmic-bg"
-> bins.cosmic-notifications => "bin/cosmic-notifications"
-> bins.cosmic-osd           => "bin/cosmic-osd"
-> bins.cosmic-workspaces    => "bin/cosmic-workspaces"
-> tags => [
    "desktop"
    "environment"
    "gui"
    "wayland"
    "compositor"
    "rust"
    "cosmic"
    "system76"
    "de"
]

[description]
-> summary => COSMIC — natywne dla Wayland, napisane w Rust środowisko graficzne od System76 (Epoch)
-> long    => COSMIC to budowane od zera środowisko graficzne dla Linuksa, tworzone przez
              System76, złożone z ok. 27 komponentów (kompozytor cosmic-comp oparty na
              Smithay, cosmic-session, cosmic-panel, cosmic-launcher, cosmic-files,
              cosmic-settings i inne) napisanych w Rust przy użyciu biblioteki widżetów
              Iced/libcosmic. Ten pakiet HPM buduje całość ze źródeł z oficjalnego
              repozytorium-superprojektu cosmic-epoch (tag epoch-1.4.0) i instaluje
              wynikowe binaria oraz zasoby (ikony, schematy, pliki .desktop komponentów)
              do ~/.hackeros/hpm/store/cosmic/. Ze względu na to, że jest to pełne
              środowisko graficzne, a nie aplikacja, ma ono świadomie wyłączony
              standardowy sandbox hpm (potrzebuje bezpośredniego dostępu do
              /dev/dri, seat/logind i gniazd Wayland/DBus, czego namespaces by nie
              udźwignęły) — zobacz sekcję [sandbox] i README.md.

[specs]
-> arch       => x86_64
-> min_kernel => 5.15

[specs.dependencies]
-> wayland => ">=1.22"
-> mesa    => ">=23.0"

[sandbox]
-> network   => true
-> gui       => true
-> full_gui  => true
-> dev       => false
-> disabled  => true
-> filesystem => [
    "/dev/dri"
    "/dev/input"
    "/run/user"
    "/run/dbus"
    "/run/systemd/seats"
    "/sys/class/drm"
]

[build]
-> commands => []
-> deb_deps => [
    "rustc"
    "cargo"
    "just"
    "pkg-config"
    "clang"
    "mold"
    "libwayland-dev"
    "libxkbcommon-dev"
    "libinput-dev"
    "libudev-dev"
    "libseat-dev"
    "libgbm-dev"
    "libdrm-dev"
    "libegl1-mesa-dev"
    "libgles2-mesa-dev"
    "libfontconfig1-dev"
    "libfreetype6-dev"
    "libpixman-1-dev"
    "libsystemd-dev"
    "libdbus-1-dev"
    "libpulse-dev"
    "libpipewire-0.3-dev"
    "libpolkit-agent-1-dev"
    "libexpat1-dev"
    "libzstd-dev"
]

[runtime]
-> deb_deps => [
    "libwayland-client0"
    "libxkbcommon0"
    "libinput10"
    "libudev1"
    "libseat1"
    "libgbm1"
    "libdrm2"
    "libegl1"
    "libgles2"
    "libfontconfig1"
    "libpixman-1-0"
    "libsystemd0"
    "libdbus-1-3"
    "libpulse0"
    "libpipewire-0.3-0"
    "polkitd"
    "mesa-vulkan-drivers"
]

[desktop]
-> display_name => COSMIC
-> icon         => icons/cosmic.svg
-> categories   => System;DesktopSettings;
-> comment      => Rust-native, Wayland-native desktop environment by System76
-> nodisplay    => true
-> keywords     => desktop;environment;wayland;compositor;rust;system76;shell;cosmic;
